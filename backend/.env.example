# Copy to .env for local development. Never commit the real .env (already gitignored at repo root).
NODE_ENV=development
PORT=8080

# docker-compose local Postgres (see docker-compose.yml)
DATABASE_URL=postgres://felix:felix@localhost:5432/felix
DATABASE_POOL_MAX=10

# docker-compose local Redis (used from Phase 1 onward — jobs, rate limits, caches)
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
TZ=Asia/Kolkata

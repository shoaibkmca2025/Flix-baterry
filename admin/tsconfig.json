{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "@felix/shared/*": [
        "../shared/*"
      ],
      "@felix/shared": [
        "../shared/domain.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*",
    "../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "../shared/tests"
  ]
}

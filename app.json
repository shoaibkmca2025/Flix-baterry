{
  "expo": {
    "name": "Felix Batteries",
    "slug": "felix-batteries",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.felixbatteries.platform"
    },
    "android": {
      "package": "com.felixbatteries.platform",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Felix | Dealer Workspace"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach battery label photos to an entry.",
          "cameraPermission": "Capture battery evidence."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan battery QR codes and barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attach your location to an entry when you choose."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "78f98d01-b9b9-4095-8a8e-d3924cda0174"
      }
    },
    "owner": "shoaib97"
  }
}
